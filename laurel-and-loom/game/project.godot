; Engine configuration file.
; Laurel & Loom — a neoclassical tactical RPG.

config_version=5

[application]

config/name="Laurel & Loom"
config/description="A neoclassical tactical RPG. Fortune is a thread: read it, cut it, turn it."
config/version="0.1.0"
run/main_scene="res://src/battle/battle.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

Game="*res://src/game.gd"

[debug]

gdscript/warnings/integer_division=0

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1600
window/size/window_height_override=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.137, 0.2, 0.31, 1)
